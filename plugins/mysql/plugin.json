{
  "id": "mysql",
  "type": 1,
  "name": "MySQL",
  "description": "Built-in MySQL driver plugin for QueryBox.",
  "version": "0.0.2",
  "runtime": {
    "kind": "local"
  },
  "capabilities": [
    "resource.graph",
    "connection.test",
    "query.execute",
    "schema.inspect",
    "explain-query",
    "mutate-row"
  ],
  "permissions": [
    {
      "name": "network"
    }
  ],
  "limits": {
    "timeout_seconds": 30
  }
}
