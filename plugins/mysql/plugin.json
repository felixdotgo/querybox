{
  "id": "mysql",
  "type": 1,
  "name": "MySQL",
  "description": "Built-in MySQL driver plugin for QueryBox.",
  "version": "0.1.2",
  "url": "https://www.mysql.com/",
  "author": "QueryBox Team",
  "runtime": {
    "kind": "local"
  },
  "capabilities": [
    "resource.graph",
    "connection.test",
    "query.execute",
    "schema.inspect",
    "explain-query",
    "mutate-row"
  ],
  "tags": [
    "sql",
    "relational"
  ],
  
  "license": "MIT",
  "icon_url": "https://www.mysql.com/common/logos/logo-mysql-170x115.png",
  "permissions": [
    {
      "name": "network"
    }
  ],
  "limits": {
    "timeout_seconds": 30
  },
  "metadata": {
    "simple_icon": "mysql"
  }
}
