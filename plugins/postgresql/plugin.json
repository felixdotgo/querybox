{
  "id": "postgresql",
  "type": 1,
  "name": "PostgreSQL",
  "description": "Built-in PostgreSQL driver plugin for QueryBox.",
  "version": "0.2.0",
  "url": "https://www.postgresql.org/",
  "author": "QueryBox Team",
  "runtime": {
    "kind": "local"
  },
  "capabilities": [
    "resource.graph",
    "connection.test",
    "query.execute",
    "schema.inspect",
    "query.explain",
    "row.mutate"
  ],
  "tags": [
    "sql",
    "relational"
  ],
  "license": "MIT",
  "icon_url": "https://www.postgresql.org/media/img/about/press/elephant.png",
  "permissions": [
    {
      "name": "network"
    }
  ],
  "limits": {
    "timeout_seconds": 30
  },
  "metadata": {
    "simple_icon": "postgresql"
  }
}
