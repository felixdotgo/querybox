{
  "id": "sqlite",
  "type": 1,
  "name": "SQLite",
  "description": "Built-in SQLite driver plugin for QueryBox.",
  "version": "0.0.2",
  "runtime": {
    "kind": "local"
  },
  "capabilities": [
    "resource.graph",
    "connection.test",
    "query.execute",
    "schema.inspect"
  ],
  "permissions": [
    {
      "name": "filesystem"
    }
  ],
  "limits": {
    "timeout_seconds": 30
  }
}
