{
  "id": "sqlite",
  "type": 1,
  "name": "SQLite",
  "description": "Built-in SQLite driver plugin for QueryBox.",
  "version": "0.1.0",
  "url": "https://www.sqlite.org/",
  "author": "QueryBox Team",
  "runtime": {
    "kind": "local"
  },
  "capabilities": [
    "resource.graph",
    "connection.test",
    "query.execute",
    "schema.inspect",
    "explain-query",
    "mutate-row"
  ],
  "tags": [
    "sql",
    "relational"
  ],
  "license": "MIT",
  "icon_url": "https://www.sqlite.org/images/logo-square.jpg",
  "permissions": [
    {
      "name": "filesystem"
    }
  ],
  "limits": {
    "timeout_seconds": 30
  },
  "metadata": {
    "simple_icon": "sqlite"
  }
}
